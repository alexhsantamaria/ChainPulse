# Conexion a PostgreSQL (ver docs/ADR/0001-arquitectura-inicial.md).
# El usuario de aplicacion NO debe ser superusuario: las politicas RLS
# (prisma/migrations/*_rls.sql) se saltan para roles con BYPASSRLS.
DATABASE_URL="postgresql://chainpulse_app:changeme@localhost:5432/chainpulse?schema=public"

# Limite de tasa (RF15/RF17, valores iniciales de calibracion, Seccion 12).
# Bloque A del Incremento 2 (PLAN-DE-TRABAJO.md Seccion 18.1.C): Postgres-
# nativo via la tabla LimiteTasa (prisma/schema.prisma), sin store externo
# -- RATE_LIMIT_STORE_URL (la variable fantasma que documentaba un store
# tipo Redis) se retira de este archivo, ya no aplica.
# HUELLA_ORIGEN_SALT: salto obligatorio para el hash de la huella de origen
# (src/infra/rateLimit/limiteTasa.ts) -- nunca se guarda la IP en claro.
# Generar con el mismo comando que NEXTAUTH_SECRET mas abajo.
HUELLA_ORIGEN_SALT="cambiar-por-un-valor-generado"

# Jobs en segundo plano (ADR-0004, Bloque A del Incremento 2). Vercel
# inyecta automaticamente "Authorization: Bearer <CRON_SECRET>" en las
# invocaciones de vercel.json si esta variable esta configurada en el
# proyecto de Vercel -- no hace falta codigo adicional para eso. El
# workflow de respaldo (.github/workflows/jobs-cron.yml) manda el mismo
# header a mano con el secreto del repo de GitHub (debe ser IGUAL a este
# valor). Generar con el mismo comando que NEXTAUTH_SECRET mas abajo.
CRON_SECRET="cambiar-por-un-valor-generado"

# Auth.js / NextAuth v5-beta (ADR-0003). Generar el secreto con:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
#
# Verificado contra node_modules/next-auth/lib/env.js (2026-09-25): esta
# version (5.0.0-beta.32) lee "process.env.AUTH_URL ?? process.env.NEXTAUTH_URL"
# y "process.env.AUTH_SECRET ?? process.env.NEXTAUTH_SECRET" -- el prefijo
# AUTH_ (nomenclatura nueva de v5) tiene PRIORIDAD si ambos estan
# definidos, pero NEXTAUTH_* sigue funcionando como fallback (no hace
# falta migrar los nombres para que el login funcione en local). Se
# documentan ambos por consistencia con la nomenclatura que Auth.js v5
# recomienda hacia adelante; usar solo un par (AUTH_* o NEXTAUTH_*), no
# hace falta duplicar valores.
#
# NEXTAUTH_URL/AUTH_URL en produccion (Vercel): debe ser la URL publica
# real (https://...), nunca localhost -- next-auth la usa para resolver
# el origin de los redirects de login/logout. Sin ella, next-auth infiere
# el host de los headers de la request; detras del proxy de Vercel esto
# normalmente funciona solo, pero fijar la variable explicita es mas
# confiable y es el paso pendiente de validar en Windows (ver
# PLAN-DE-TRABAJO.md Seccion 21 y la revision de redireccion post-login
# que Alex reporto pendiente el 2026-09-25).
NEXTAUTH_SECRET="cambiar-por-un-valor-generado"
NEXTAUTH_URL="http://localhost:3000"
# AUTH_SECRET="cambiar-por-un-valor-generado"  # alias opcional de NEXTAUTH_SECRET, prioridad si ambos estan definidos
# AUTH_URL="http://localhost:3000"             # alias opcional de NEXTAUTH_URL, prioridad si ambos estan definidos -- en produccion, la URL publica real

# Para prisma/seed.ts (npm run prisma:seed) Y para "directUrl" en el
# datasource de prisma/schema.prisma (npm run prisma:migrate). SEED_DATABASE_URL
# es OBLIGATORIO para ambos: debe apuntar al rol neondb_owner, no a
# chainpulse_app. El seed crea una empresa desde cero y las politicas RLS
# de "empresas" (prisma/rls.sql) rechazan ese INSERT con el rol
# restringido de la app (RNF1); migrar tiene el mismo problema de permisos
# (DDL) mas el de P3014 (ver comentario de shadowDatabaseUrl arriba) --
# por eso "directUrl" en schema.prisma apunta aca tambien: Prisma lo usa
# automaticamente para migrar sin tener que cambiar DATABASE_URL a mano.
# SEED_ADMIN_EMAIL/SEED_ADMIN_PASSWORD son opcionales, con valores por
# defecto si se omiten.
SEED_DATABASE_URL="postgresql://neondb_owner:changeme@localhost:5432/chainpulse?schema=public"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Solo para "npx prisma migrate dev" (no para correr la app). Neon no le
# da CREATEDB a ningun rol, asi que Prisma no puede crear su base de
# sombra temporal sola (error P3014) -- apunta a una segunda base creada
# a mano desde la consola de Neon (Databases -> New Database), con el
# rol neondb_owner. Mismo host que DATABASE_URL, solo cambia el nombre
# de la base en la ruta.
SHADOW_DATABASE_URL="postgresql://neondb_owner:changeme@localhost:5432/chainpulse_shadow?schema=public"

# RF4 — invitacion de responsables por correo (Resend, ver src/infra/email/resend.ts).
# Sin un dominio propio verificado en Resend, solo se puede mandar a la
# direccion con la que se creo la cuenta de Resend (modo sandbox).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Cloudflare R2 (Incremento 4 Bloque B, almacenamiento de objetos para
# CSVs de importacion -- ver docs/ADR/0006-cifrado-r2.md). Alex crea el
# bucket y el token en su cuenta de Cloudflare (nunca pega los valores en
# el chat) -- ver el checklist en PLAN-DE-TRABAJO.md, Setup de R2:
#   - Bucket privado, SIN acceso publico r2.dev.
#   - Token de API con scope de Object Read & Write LIMITADO a este
#     bucket, nunca administracion general de la cuenta.
#   - Buckets/tokens SEPARADOS para desarrollo/test y para produccion --
#     mismo nombre de variable acá, valor distinto por entorno en Vercel
#     (Development/Preview/Production), igual que DATABASE_URL.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Cifrado de aplicacion sobre lo que sube a R2 (envelope encryption
# AES-256-GCM, ver src/infra/storage/cifradoObjeto.ts y docs/ADR/0006-
# cifrado-r2.md) -- INDEPENDIENTE de las 4 variables de R2 de arriba y de
# NEXTAUTH_SECRET. Generar R2_ENCRYPTION_KEY_ACTIVA con:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# R2_ENCRYPTION_KEY_ACTIVA_ID es un identificador corto NO secreto que vos
# elegis (ej. "2026-09"), se guarda junto a cada archivo para saber con
# que clave se cifro -- necesario para poder rotar la clave sin re-cifrar
# nada ya subido. R2_ENCRYPTION_KEYS_ANTERIORES queda vacio hasta la
# primera rotacion (formato y procedimiento completo en el ADR).
# IMPORTANTE -- guardar un backup offline de esta clave en algun lugar
# fuera de Vercel (gestor de contraseñas, etc.): si se pierde sin backup,
# los CSV ya cifrados con ella quedan ilegibles para siempre (ver ADR).
R2_ENCRYPTION_KEY_ACTIVA=""
R2_ENCRYPTION_KEY_ACTIVA_ID=""
R2_ENCRYPTION_KEYS_ANTERIORES=""

# Sentry (observabilidad minima, PLAN-DE-TRABAJO.md Seccion 18.1.B,
# Incremento 2) -- bloqueante antes de exponer /api/public/evaluations/*
# a trafico anonimo real. Crear un proyecto gratuito (plan Developer) en
# sentry.io, tipo "Next.js", y copiar el DSN desde su pantalla de
# configuracion. NEXT_PUBLIC_SENTRY_DSN y SENTRY_DSN suelen ser el MISMO
# valor (un DSN no es secreto, solo permite enviar eventos, no leerlos) --
# se piden separados porque el SDK los lee de variables distintas segun
# el runtime (navegador vs. servidor/edge).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# "development" en local; en Vercel se puede mapear desde VERCEL_ENV si
# se prefiere no fijarlo a mano por entorno.
SENTRY_ENVIRONMENT="development"
# Apagado (0) hasta validar en produccion con trafico real -- evita
# consumir la cuota del plan gratuito con transacciones de desarrollo.
SENTRY_TRACES_SAMPLE_RATE="0"
# Diferidos hasta que exista CI (no bloquean el Incremento 2): sin estos
# 3, el build simplemente no sube sourcemaps a Sentry, no falla.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
