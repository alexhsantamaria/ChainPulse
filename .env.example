# Conexion a PostgreSQL (ver docs/ADR/0001-arquitectura-inicial.md).
# El usuario de aplicacion NO debe ser superusuario: las politicas RLS
# (prisma/migrations/*_rls.sql) se saltan para roles con BYPASSRLS.
DATABASE_URL="postgresql://chainpulse_app:changeme@localhost:5432/chainpulse?schema=public"

# Limite de tasa (RF15/RF17, valores iniciales de calibracion, Seccion 12).
# Bloque A del Incremento 2 (PLAN-DE-TRABAJO.md Seccion 18.1.C): Postgres-
# nativo via la tabla LimiteTasa (prisma/schema.prisma), sin store externo
# -- RATE_LIMIT_STORE_URL (la variable fantasma que documentaba un store
# tipo Redis) se retira de este archivo, ya no aplica.
# HUELLA_ORIGEN_SALT: salto obligatorio para el hash de la huella de origen
# (src/infra/rateLimit/limiteTasa.ts) -- nunca se guarda la IP en claro.
# Generar con el mismo comando que NEXTAUTH_SECRET mas abajo.
HUELLA_ORIGEN_SALT="cambiar-por-un-valor-generado"

# Jobs en segundo plano (ADR-0004, Bloque A del Incremento 2). Vercel
# inyecta automaticamente "Authorization: Bearer <CRON_SECRET>" en las
# invocaciones de vercel.json si esta variable esta configurada en el
# proyecto de Vercel -- no hace falta codigo adicional para eso. El
# workflow de respaldo (.github/workflows/jobs-cron.yml) manda el mismo
# header a mano con el secreto del repo de GitHub (debe ser IGUAL a este
# valor). Generar con el mismo comando que NEXTAUTH_SECRET mas abajo.
CRON_SECRET="cambiar-por-un-valor-generado"

# Auth.js / NextAuth (ADR-0003). Generar con:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
NEXTAUTH_SECRET="cambiar-por-un-valor-generado"
NEXTAUTH_URL="http://localhost:3000"

# Solo para prisma/seed.ts (npm run prisma:seed). SEED_DATABASE_URL es
# OBLIGATORIO (el script no corre sin el): debe apuntar al rol
# neondb_owner, no a chainpulse_app — el seed crea una empresa desde
# cero y las politicas RLS de "empresas" (prisma/rls.sql) rechazan ese
# INSERT si se corre con el rol restringido de la app (RNF1, mismo caso
# que una migracion). SEED_ADMIN_EMAIL/SEED_ADMIN_PASSWORD son
# opcionales, con valores por defecto si se omiten.
SEED_DATABASE_URL="postgresql://neondb_owner:changeme@localhost:5432/chainpulse?schema=public"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Solo para "npx prisma migrate dev" (no para correr la app). Neon no le
# da CREATEDB a ningun rol, asi que Prisma no puede crear su base de
# sombra temporal sola (error P3014) -- apunta a una segunda base creada
# a mano desde la consola de Neon (Databases -> New Database), con el
# rol neondb_owner. Mismo host que DATABASE_URL, solo cambia el nombre
# de la base en la ruta.
SHADOW_DATABASE_URL="postgresql://neondb_owner:changeme@localhost:5432/chainpulse_shadow?schema=public"

# RF4 — invitacion de responsables por correo (Resend, ver src/infra/email/resend.ts).
# Sin un dominio propio verificado en Resend, solo se puede mandar a la
# direccion con la que se creo la cuenta de Resend (modo sandbox).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
