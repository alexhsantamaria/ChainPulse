# Conexion a PostgreSQL (ver docs/ADR/0001-arquitectura-inicial.md).
# El usuario de aplicacion NO debe ser superusuario: las politicas RLS
# (prisma/migrations/*_rls.sql) se saltan para roles con BYPASSRLS.
DATABASE_URL="postgresql://chainpulse_app:changeme@localhost:5432/chainpulse?schema=public"

# Limite de tasa (RF15/RF17, valores iniciales de calibracion, Seccion 12).
# Store externo requerido en despliegues serverless (ver ADR-0001, adenda).
RATE_LIMIT_STORE_URL=""
