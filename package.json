{
  "name": "chainpulse",
  "version": "0.1.0",
  "private": true,
  "description": "ChainPulse — SaaS de diagnostico de cadenas de suministro. Incremento 1 (ver requirements.md Secciones 9-12 y docs/ADR).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "seed:cuestionario-v2": "tsx prisma/seedCuestionarioV2.ts",
    "seed:definiciones-kpi": "tsx prisma/seedDefinicionesKpi.ts",
    "jobs:bootstrap": "tsx scripts/bootstrapPgBoss.ts",
    "jobs:drenar-importaciones-csv": "tsx scripts/drenarColaImportacionCsv.ts",
    "cobertura:verificar": "tsx scripts/verificarObservacionesCobertura.ts",
    "limpiar:tenants-prueba": "tsx scripts/limpiarTenantsPrueba.ts",
    "limpiar:cadenas-duplicadas": "tsx scripts/limpiarCadenasDuplicadas.ts",
    "r2:probar": "tsx scripts/probarR2.ts",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.5.0",
    "@sentry/nextjs": "^10.75.0",
    "@types/papaparse": "^5.5.2",
    "@xyflow/react": "^12.11.6",
    "jose": "^6.2.12",
    "next": "^15.5.26",
    "next-auth": "^5.0.0-beta.32",
    "otpauth": "^9.5.2",
    "papaparse": "^5.7.0",
    "pg": "^8.13.0",
    "pg-boss": "^12.32.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.28.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "husky": "^9.1.7",
    "postcss": "^8.4.49",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
