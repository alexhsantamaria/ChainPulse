// ChainPulse — modelo de datos del Incremento 1.
// Trazabilidad: cada campo no obvio cita el RF/RNF o la ronda de decisiones
// de requirements.md que lo origina. Ver tambien docs/ADR/0001 y 0002.
//
// Aislamiento multi-tenant (RNF1): todo modelo con "empresaId" se protege
// con DOS capas independientes, ninguna opcional:
//   1. La extension de Prisma en src/infra/prisma/tenantClient.ts, que
//      inyecta el filtro de tenant en cada consulta.
//   2. Row-Level Security de PostgreSQL (prisma/migrations/*_rls.sql),
//      que rechaza filas fuera del tenant activo aunque el codigo falle.
// EvaluacionExpres y sus hijas NO llevan empresaId (adenda de ADR-0001):
// es el caso explicito de tenant nulo en las politicas RLS.

generator client {
  provider   = "prisma-client-js"
  // ADR-0003 (adenda ARM64): motor sin binario Rust. La build nativa de
  // Windows ARM64 del query engine no existe (issue cerrado como "not
  // planned" por Prisma) — con engineType="client" el cliente corre en
  // TypeScript puro sobre un driver adapter (src/infra/prisma/client.ts),
  // sin binario nativo que pueda ser incompatible con la arquitectura.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Neon: el rol de la app (y hasta neondb_owner) no tiene privilegio
  // CREATEDB, asi que "prisma migrate dev" no puede crear su base de
  // sombra temporal sola (error P3014). shadowDatabaseUrl apunta a una
  // segunda base ya creada a mano en la consola de Neon (no por SQL,
  // no necesita CREATEDB) -- ver .env.example y el README.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  // directUrl -- "prisma migrate dev"/"migrate deploy" usan esta URL en
  // vez de la de arriba para ejecutar las migraciones (Prisma switchea
  // automaticamente a directUrl cuando esta presente); DATABASE_URL sigue
  // siendo lo que usa el cliente en runtime (rol chainpulse_app, endpoint
  // pooled). SEED_DATABASE_URL ya existia para prisma/seed.ts (rol
  // neondb_owner) y se reusa aca con el mismo rol: migrar tambien necesita
  // permisos de owner, y de paso evita correr DDL a traves del pooler.
  // Nunca hace falta cambiar DATABASE_URL a mano para migrar -- ese fue
  // un error real de esta sesion (ver claude/lecciones-aprendidas.md en el
  // proyecto de Claude).
  directUrl = env("SEED_DATABASE_URL")
}

enum RolUsuario {
  ADMINISTRADOR
  RESPONSABLE
}

// RF3 / Seccion 12: grado de dependencia, uno de los 4 valores de una Conexion.
enum GradoDependencia {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

// RF3 / Seccion 12: cortes de calibracion inicial para "tiempo tolerable" y
// "tiempo de recuperacion" — Corto = menos de 24h, Medio = 24h-1 semana,
// Largo = mas de 1 semana. Valor de calibracion, ajustable con datos reales.
enum DuracionCategorica {
  CORTO
  MEDIO
  LARGO
}

// Principio de copy de ADR-0002 (punto 4) y campo de esquema pedido por
// CTO en la quinta ronda (Seccion 12): default DECLARADO en el Incremento 1,
// sin UI todavia — evita migrar datos historicos cuando el nivel 3 de
// visualizacion (Seccion 10) necesite distinguir declarado/inferido/verificado.
enum EstadoDato {
  DECLARADO
  INFERIDO
  VERIFICADO
}

// Bloque A del Incremento 2 (PLAN-DE-TRABAJO.md Seccion 18.1.C/18.2.B) — RF15
// distingue el inicio de una evaluacion del desbloqueo de su detalle (RF17),
// ambos protegidos por LimiteTasa con el mismo mecanismo pero contadores
// independientes.
enum BucketLimiteTasa {
  INICIO_EVALUACION
  DESBLOQUEO_DETALLE
}

// RF3, engine v1 (src/engine/criticidad.ts): nivel categorico del impacto
// de una interrupcion sobre la promesa al cliente. RF3 no fijaba una
// escala cerrada para este campo (hallazgo de Full-Stack en la quinta
// ronda) — se adopta esta de 4 niveles, simetrica a GradoDependencia, como
// hipotesis inicial de calibracion (mismo criterio que los demas valores
// numericos de la Seccion 12), ajustable con datos reales de los pilotos.
enum NivelImpacto {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum EstadoCiclo {
  ABIERTO
  CERRADO
}

// RF12: la dimension que el resultado macro senala como "la peor" en la
// frase breve en lenguaje llano.
enum DimensionDiagnostico {
  SALUD
  CRITICIDAD
  DEPENDENCIA
  RIESGO
}

// Incremento 2 (Evaluacion expres V2, PLAN-DE-TRABAJO.md Seccion 18.1.A/18.3.A) —
// identidad separada para los actores de plataforma (Curador metodologico,
// Administrador de plataforma), fuera de RLS/TENANT_SCOPED_MODELS a
// proposito (mismo criterio de "tenant nulo" que EvaluacionExpres): un
// UsuarioPlataforma NUNCA tiene empresaId, ni se accede via tenantClient().
// Ver src/infra/auth-plataforma/ para el flujo de sesion (JWT propio via
// "jose", cookie y secreto distintos de NextAuth — nunca se amplia
// next-auth.d.ts para acomodar este actor).
enum RolUsuarioPlataforma {
  CURADOR_METODOLOGICO
  ADMINISTRADOR_PLATAFORMA
}

// Incremento 2 (Seccion 18.3.A) — patron de versionado nativo en BD:
// aggregate (CuestionarioVersion) + filas hijas inmutables (PreguntaVersion).
// Un Curador metodologico edita contenido sin deploy; una version PUBLICADA
// nunca se edita (modulo unico de escritura + indice unico parcial en la
// migracion, ver prisma/migrations). Corregir crea numero+1, nunca UPDATE.
enum EstadoVersionContenido {
  BORRADOR
  PUBLICADA
  RETIRADA
}

// RF21, motor v2 (src/engine/v2/) — estado categorico por dimension del
// cuestionario condensado. NO es lo mismo que el campo existente
// "indiceIntegracion" (float, motor v1, RF16): una es un estado categorico
// por dimension del motor V2, la otra es un indice numerico agregado del
// motor v1 — coexisten con nombres parecidos a proposito, nunca confundir.
enum DimensionDiagnosticoV2 {
  ALINEACION
  COORDINACION
  INTEGRACION
  EVIDENCIA
  RESILIENCIA
}

// RF22 (Seccion 18.2.C) — cuanta confianza tiene un hallazgo de la
// evaluacion expres V2. NO es lo mismo que el enum ya existente EstadoDato
// (que responde "como se obtuvo el valor de este campo") pese al valor
// DECLARADO compartido — son dos taxonomias distintas, nunca reutilizar
// una por la otra (ver docs/PATRONES.md).
enum EstadoEvidencia {
  DECLARADO
  CONFIRMADO_POR_OTROS
  VERIFICADO_CON_DATOS
}

// RF23/RF24 (Seccion 18.2.A) — las 4 finalidades de consentimiento de V2.
// Solo DIAGNOSTICO e INVESTIGACION se piden activamente en este incremento
// (ver requirements.md Seccion 13.8) — ESTADISTICAS_COMERCIALES y
// CONTACTO_COMERCIAL quedan en el enum para Incremento 6/7, sin UI propia
// todavia.
enum FinalidadConsentimiento {
  DIAGNOSTICO
  INVESTIGACION
  ESTADISTICAS_COMERCIALES
  CONTACTO_COMERCIAL
}

enum MetodoRetiro {
  NINGUNO
  FORMULARIO_PUBLICO
  SOLICITUD_SOPORTE
}

// Incremento 3 (Mapa y profundidad, requirements.md Seccion 14) --
// catalogo de Nodo, mas amplio que Eslabon: puede ser tambien una persona
// decisora o un sistema, no solo un area/proceso (Seccion 5 de
// MVP-DEFINITIVO.md).
enum TipoNodo {
  ORGANIZACION
  AREA
  INSTALACION
  PROCESO
  PERSONA_DECISORA
  SISTEMA
}

// RF29 -- una ConexionCadena soporta multiples flujos simultaneos, cada
// uno tipificado con este enum (V2 Seccion 9.1).
enum TipoFlujoV2 {
  PRODUCTO_SERVICIO
  INFORMACION
  DINERO
  DECISION
  DEVOLUCION
}

// Bloque C (RF36-39) -- vocabulario propio de RespuestaCadena, NO
// reutiliza el sistema versionado de PreguntaVersion/OpcionRespuesta de
// Q1-Q7 (RF19-26, Usuario de plataforma) -- seria arrastrar toda esa
// infraestructura de contenido versionado para un cuestionario fijo de
// 6 dimensiones que no lo necesita (Seccion 14.4/14.5 de requirements.md
// no lo pide). Las opciones citan el mismo lenguaje que Q1/Q3/Q5 del
// cuestionario V2 (CHAINPULSE_ESPECIFICACION_FUNCIONAL_TECNICA_V2.md
// Seccion 7.2) solo por consistencia de UX, sin ninguna FK ni relacion
// de datos entre ambos sistemas.

// "Prioridad elegida" (RF38) -- mismas 8 opciones de Q1 V2.
enum PromesaPrincipalCadena {
  DISPONIBILIDAD
  RAPIDEZ
  CUMPLIMIENTO_FECHA_CANTIDAD
  CALIDAD_CONSISTENCIA
  PRECIO_EFICIENCIA
  PERSONALIZACION
  CONTINUIDAD_INTERRUPCIONES
  NO_DEFINIDA
}

// "Conocimiento de entradas/salidas" (RF38) -- mismas 5 opciones de Q3 V2.
enum ConocimientoEntradaSalida {
  DEFINIDO_Y_USADO
  CLARO_PARA_ALGUNAS_AREAS
  DEPENDE_DE_PERSONAS
  NO_CLARO
  NO_SABE
}

// "Fuente de datos" (RF38) -- mismo catalogo de la subpregunta contextual
// de Q5 V2.
enum FuenteDatosCadena {
  SAP_ERP
  EXCEL
  WMS_TMS_APS
  CORREO_MENSAJERIA
  VARIOS_SISTEMAS
  SIN_FUENTE_DEFINIDA
}

// RF38 -- las seis dimensiones de comparacion multi-rol de V2 Seccion 10.
enum DimensionComparacionCadena {
  PRIORIDAD_ELEGIDA
  CONOCIMIENTO_ENTRADAS_SALIDAS
  MOMENTO_INFORMACION
  FUENTE_DATOS
  NODO_CRITICO
  ALTERNATIVA_DISPONIBLE
}

// RF38 -- los 4 estados posibles del resultado de una comparacion.
enum ResultadoComparacion {
  ACUERDO
  ACUERDO_PARCIAL
  DIFERENCIA
  SIN_RESPUESTA_SUFICIENTE
}

// RF1 — tenant.
model Empresa {
  id        String   @id @default(cuid())
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios   Usuario[]
  eslabones  Eslabon[]
  ciclos     CicloPulso[]
  conexiones Conexion[]
  consentimientosCuenta ConsentimientoCuenta[]
  cadenas Cadena[]
  nodos Nodo[]
  conexionesCadena ConexionCadena[]
  hallazgosCadena HallazgoCadena[]
  respuestasCadena RespuestaCadena[]

  @@map("empresas")
}

// RF1/RF4. El mecanismo de autenticacion (password, magic link, MFA) queda
// pendiente de un ADR propio (Seguridad, Seccion 12) — este modelo es
// deliberadamente minimo, sin inventar esa decision aqui.
model Usuario {
  id        String     @id @default(cuid())
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  // ADR-0003: email UNICO GLOBAL (no compuesto con empresaId) — el login
  // busca por email sin conocer el tenant de antemano, via la funcion
  // Postgres SECURITY DEFINER login_lookup() (prisma/auth_functions.sql).
  // Unica excepcion deliberada y acotada al aislamiento por RLS.
  email     String     @unique
  nombre    String
  rol       RolUsuario

  // ADR-0003: hash Argon2id, nunca texto plano (src/infra/auth/password.ts).
  passwordHash String

  // ADR-0003: MFA (TOTP) obligatorio para ADMINISTRADOR desde el Incremento 1.
  mfaSecret     String?
  mfaHabilitado Boolean @default(false)

  // ADR-0003: rate limiting / bloqueo temporal contra fuerza bruta en el login.
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?

  // RF4: un Responsable queda limitado a las conexiones de su propio eslabon.
  eslabonId String?
  eslabon   Eslabon?   @relation(fields: [eslabonId], references: [id])

  respuestas RespuestaCruda[]
  // RNF9 -- instrumentacion minima (ver los dos modelos nuevos al final
  // de este archivo).
  metricasCuestionario       MetricaCuestionario[]
  recomendacionesEjecutadas  RecomendacionEjecutada[]
  consentimientosCuenta      ConsentimientoCuenta[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([empresaId])
  @@map("usuarios")
}

// RF2 / Seccion 3 — nodo de la cadena de suministro (sustituye "Area/Proceso").
model Eslabon {
  id                 String     @id @default(cuid())
  empresaId          String
  empresa            Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre             String
  // Seccion 7 / Seccion 8: modelo flexible desde ya para representar un
  // proveedor externo mas adelante sin rediseno (no se construye UI propia
  // de "Proveedor" en el MVP).
  esProveedorExterno Boolean    @default(false)
  // CTO, Seccion 12: campo de nivel 3 de visualizacion, sin UI en Incremento 1.
  tipoFlujo          String?
  estado             EstadoDato @default(DECLARADO)

  conexionesOrigen  Conexion[] @relation("conexion_origen")
  conexionesDestino Conexion[] @relation("conexion_destino")
  responsables      Usuario[]
  // Incremento 3 (RF28) -- puente opcional desde Nodo, sin fusion conceptual.
  nodosCadena       Nodo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@map("eslabones")
}

// RF3 — dependencia declarada entre dos eslabones, con sus 4 valores base.
// "completa" (RF3/Seccion 6) es false hasta que los 5 datos de este
// requisito quedan confirmados; una conexion incompleta se excluye de RF7
// y RF16.
model Conexion {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  origenId  String
  origen    Eslabon @relation("conexion_origen", fields: [origenId], references: [id])
  destinoId String
  destino   Eslabon @relation("conexion_destino", fields: [destinoId], references: [id])

  gradoDependencia GradoDependencia?
  impactoPromesaCliente NivelImpacto?
  tieneAlternativa      Boolean?
  tiempoTolerable       DuracionCategorica?
  tiempoRecuperacion    DuracionCategorica?
  // Metadatos de procedencia (CTO, Seccion 12): cuando se confirmaron los
  // datos de criticidad, para poder auditar sin fragmentar ruleVersion.
  criticidadConfirmadaEn DateTime?

  tipoFlujo String?
  estado    EstadoDato @default(DECLARADO)
  completa  Boolean    @default(false)

  respuestas RespuestaCruda[]
  resultados ResultadoConexion[]
  // RNF9 -- si esta conexion (como eslabon mas debil de algun ciclo,
  // RF7/RF8) tuvo su recomendacion marcada como ejecutada.
  recomendacionesEjecutadas RecomendacionEjecutada[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([origenId, destinoId])
  @@index([empresaId])
  @@map("conexiones")
}

// RF5 — periodo durante el cual se envia y recoge el cuestionario.
model CicloPulso {
  id        String      @id @default(cuid())
  empresaId String
  empresa   Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  estado    EstadoCiclo @default(ABIERTO)
  abiertoEn DateTime    @default(now())
  cerradoEn DateTime?
  // RF10: % de responsables que completaron, fijado al cerrar el ciclo.
  coberturaRespuesta Float?

  respuestas         RespuestaCruda[]
  resultadosConexion ResultadoConexion[]
  resultadoCiclo     ResultadoCiclo?
  // RNF9 -- instrumentacion minima.
  metricasCuestionario       MetricaCuestionario[]
  recomendacionesEjecutadas  RecomendacionEjecutada[]

  // R5-7 -- ademas de este indice normal, la migracion
  // 20260916160000_ciclo_abierto_unico agrega un indice UNICO PARCIAL
  // ("estado" = 'ABIERTO') que Prisma no puede expresar en este DSL. No
  // lo borres en un `prisma migrate dev` futuro por "drift": es
  // intencional (ver el comentario en esa migracion).
  @@index([empresaId])
  @@map("ciclos_pulso")
}

// RF6 / Seccion 12 — respuesta individual, nunca solo el agregado (RNF6).
// Escala Likert 1-5; "noSabe"/"noAplica" nunca cuentan como el minimo de
// la escala (ver src/engine/salud.ts).
model RespuestaCruda {
  id            String     @id @default(cuid())
  cicloPulsoId  String
  cicloPulso    CicloPulso @relation(fields: [cicloPulsoId], references: [id], onDelete: Cascade)
  conexionId    String
  conexion      Conexion   @relation(fields: [conexionId], references: [id], onDelete: Cascade)
  responsableId String
  // Hallazgo real de RNF1 (ver README): sin onDelete: Cascade aca, borrar
  // un Usuario con respuestas propias fallaba (RESTRICT/NO ACTION, el
  // default de Postgres) aunque la respuesta tambien fuera a borrarse por
  // el otro camino (cicloPulso -> respuesta, que si cascadea). Corregido
  // en la misma migracion que agrega las tablas de RNF9 mas abajo.
  responsable   Usuario    @relation(fields: [responsableId], references: [id], onDelete: Cascade)

  valor    Int? // 1-5; null si noSabe o noAplica
  noSabe   Boolean @default(false)
  noAplica Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([cicloPulsoId, conexionId, responsableId])
  @@index([cicloPulsoId])
  @@map("respuestas_crudas")
}

// RF7 — resultado inmutable por conexion y ciclo (RNF6: nunca se recalcula
// por referencia viva a Conexion; si RF3 se edita despues del cierre, el
// resultado ya persistido no cambia). Un unico "ruleVersion" por resultado
// (CTO, Seccion 12) — no fragmentado por dimension.
model ResultadoConexion {
  id           String     @id @default(cuid())
  cicloPulsoId String
  cicloPulso   CicloPulso @relation(fields: [cicloPulsoId], references: [id], onDelete: Cascade)
  conexionId   String
  conexion     Conexion   @relation(fields: [conexionId], references: [id], onDelete: Cascade)

  salud   Float // 0-100 (RF6)
  // Snapshot de los datos de criticidad al momento del cierre del ciclo,
  // no una referencia viva a Conexion (CTO, Seccion 12).
  criticidadSnapshot      Json
  gradoDependenciaSnapshot GradoDependencia
  riesgo                  Float

  ruleVersion String
  createdAt   DateTime @default(now())

  @@unique([cicloPulsoId, conexionId])
  @@index([cicloPulsoId])
  @@map("resultados_conexion")
}

// RF7 (conjunto no dominado) + RF16 (indice de integracion) — el agregado
// de un ciclo completo, tambien inmutable.
model ResultadoCiclo {
  id           String     @id @default(cuid())
  cicloPulsoId String     @unique
  cicloPulso   CicloPulso @relation(fields: [cicloPulsoId], references: [id], onDelete: Cascade)

  indiceIntegracion    Float // RF16
  // conexionId[] del conjunto no dominado, YA ordenados por el criterio de
  // lectura de RF7 (criticidad desc, salud asc, riesgo desc, dependencia
  // desc, id) — ver src/engine/eslabonMasDebil.ts.
  eslabonesMasDebilesIds String[]

  ruleVersion String
  createdAt   DateTime @default(now())

  @@map("resultados_ciclo")
}

// RNF9 — instrumentacion minima: cuanto tarda un responsable en
// completar el cuestionario de un ciclo (RF6), frente al limite de 5
// minutos de RNF2. Una fila por envio, no por respuesta individual (una
// persona responde varias conexiones de una vez). La duracion se mide en
// el cliente (desde que carga el formulario hasta que se envia,
// src/app/dashboard/ciclos/[id]/responder/ResponderCuestionarioForm.tsx)
// y llega ya calculada junto con las respuestas -- no hace falta un
// evento de "inicio" separado en el servidor. No es un sistema de
// analitica de producto completo (Seccion 12 de requirements.md): esto
// es la senal minima para una consulta agregada simple, no un evento por
// interaccion.
model MetricaCuestionario {
  id               String     @id @default(cuid())
  cicloPulsoId     String
  cicloPulso       CicloPulso @relation(fields: [cicloPulsoId], references: [id], onDelete: Cascade)
  responsableId    String
  responsable      Usuario    @relation(fields: [responsableId], references: [id], onDelete: Cascade)
  duracionSegundos Int

  createdAt DateTime @default(now())

  @@index([cicloPulsoId])
  @@map("metricas_cuestionario")
}

// RNF9 — si el administrador o el responsable de una conexion marca la
// recomendacion priorizada (RF8) como ejecutada. La recomendacion en si
// no se persiste (ver src/engine/recomendacion.ts) -- esto se ancla al
// par (ciclo, conexion) que la genero, no al texto/prioridad puntual
// (que puede recalcularse distinto si las reglas cambian mas adelante).
// @@unique evita marcar la misma dos veces.
model RecomendacionEjecutada {
  id           String     @id @default(cuid())
  cicloPulsoId String
  cicloPulso   CicloPulso @relation(fields: [cicloPulsoId], references: [id], onDelete: Cascade)
  conexionId   String
  conexion     Conexion   @relation(fields: [conexionId], references: [id], onDelete: Cascade)
  marcadaPorId String
  marcadaPor   Usuario    @relation(fields: [marcadaPorId], references: [id], onDelete: Cascade)

  marcadaEn DateTime @default(now())

  @@unique([cicloPulsoId, conexionId])
  @@map("recomendaciones_ejecutadas")
}

// RF11-RF18 — evaluacion exprés publica. Sin tenantId a proposito (RNF7):
// fuente de datos separada de las cuentas registradas, nunca mezclada al
// recalcular o mejorar el motor sin un criterio explicito de ponderacion.
model EvaluacionExpres {
  id          String @id @default(cuid())
  ruleVersion String

  // Resultado macro (RF12): se calcula UNA sola vez aqui y se persiste de
  // inmediato — el gate de RF13 solo revela campos de este mismo registro,
  // nunca recalcula (CTO, Seccion 12: gate de presentacion, no de computo).
  saludPromedio       Float
  criticidadPromedio  Float
  dependenciaPromedio Float
  riesgoPromedio      Float
  indiceIntegracion   Float // RF16
  dimensionMasDebil   DimensionDiagnostico

  // Gate de detalle (RF13/RF17).
  detalleDesbloqueado   Boolean   @default(false)
  detalleDesbloqueadoEn DateTime?
  correo                String?
  nombreCompleto        String?
  empresaNombre         String?
  telefono              String? // RF13: opcional, no bloquea el desbloqueo
  consentimientoEnvio           Boolean @default(false)
  consentimientoMejoraAlgoritmo Boolean @default(false)

  // RF15/RF17 + retencion de la Seccion 12: huella de origen SOLO para
  // limitar abuso, purgada a las 48-72h (antes que cualquier otro dato de
  // esta fila) via el job descrito en src/infra/retencion.ts.
  huellaOrigen          String
  huellaOrigenPurgadaEn DateTime?

  createdAt DateTime @default(now())

  eslabones  EvaluacionExpresEslabon[]
  conexiones EvaluacionExpresConexion[]

  @@index([huellaOrigen])
  @@index([createdAt])
  @@map("evaluaciones_expres")
}

// RF11 — version condensada de Eslabon, propia de la evaluacion exprés.
model EvaluacionExpresEslabon {
  id                 String           @id @default(cuid())
  evaluacionExpresId String
  evaluacionExpres   EvaluacionExpres @relation(fields: [evaluacionExpresId], references: [id], onDelete: Cascade)
  nombre             String
  tipoFlujo          String?
  estado             EstadoDato       @default(DECLARADO)

  @@index([evaluacionExpresId])
  @@map("evaluaciones_expres_eslabones")
}

// RF11/RF18 — version condensada de Conexion. "descripcionLibre" es el
// campo de texto libre que RF18 protege con un alias sugerido por defecto
// en la UI (no se valida/bloquea aqui, es una guia de minimizacion).
model EvaluacionExpresConexion {
  id                 String           @id @default(cuid())
  evaluacionExpresId String
  evaluacionExpres   EvaluacionExpres @relation(fields: [evaluacionExpresId], references: [id], onDelete: Cascade)

  origenNombre  String
  destinoNombre String

  gradoDependencia       GradoDependencia
  impactoPromesaCliente  NivelImpacto?
  tieneAlternativa       Boolean?
  tiempoTolerable        DuracionCategorica?
  tiempoRecuperacion     DuracionCategorica?
  descripcionLibre       String?

  // Salud declarada por el visitante para esta conexion (percepcion de una
  // sola persona — RNF7, confiabilidad distinta a un ciclo real).
  salud Float?

  @@index([evaluacionExpresId])
  @@map("evaluaciones_expres_conexiones")
}

// Bloque A del Incremento 2 (PLAN-DE-TRABAJO.md Seccion 18.1.C, 18.4.F) —
// rate limiting Postgres-nativo de RF15/RF17, sin Redis/store externo (por
// eso RATE_LIMIT_STORE_URL sale de .env.example, ver Seccion 18.1.C). Tenant
// nulo explicito, mismo caso que EvaluacionExpres arriba: nunca lleva
// empresaId ni entra en las politicas de prisma/rls.sql. huellaOrigenHash es
// siempre un hash salteado (nunca la IP en claro, src/infra/rateLimit) y
// ventanaInicio es el inicio del bucket de 15 minutos en curso (R5-19,
// Ronda 5: antes un bucket fijo de 60 min duplicaba de hecho el limite
// alrededor de cada frontera de hora; registrarIntento() ahora suma los
// ultimos 4 buckets de 15 min como ventana deslizante aproximada, ver
// src/infra/rateLimit/huella.ts) — la fila se resuelve con un UPSERT
// atomico (src/infra/rateLimit/limiteTasa.ts) para que invocaciones
// serverless concurrentes nunca pierdan un incremento.
model LimiteTasa {
  id                String            @id @default(cuid())
  huellaOrigenHash  String
  bucket            BucketLimiteTasa
  ventanaInicio     DateTime
  contador          Int               @default(0)
  createdAt         DateTime          @default(now())

  @@unique([huellaOrigenHash, bucket, ventanaInicio])
  @@index([ventanaInicio])
  @@map("limite_tasa")
}

// ============================================================================
// Incremento 2 — Evaluacion expres V2 (requirements.md Seccion 13, RF19-RF26;
// PLAN-DE-TRABAJO.md Seccion 18). Todas las tablas de este bloque son
// CREATE TABLE/CREATE TYPE puros — ninguna toca las tablas del Incremento 1.
// ============================================================================

// RF19 — actor de plataforma, identidad completamente separada de
// Usuario/Empresa (Seccion 18.1.A). Nunca entra en TENANT_SCOPED_MODELS ni
// en prisma/rls.sql — mismo regimen de tenant nulo que EvaluacionExpres.
// MFA obligatorio desde el primer login para los 2 roles, sin excepcion
// (Seccion 18.2.F: incluso CURADOR_METODOLOGICO tiene impacto amplio,
// puede publicar una PreguntaVersion que afecta el motor de scoring de
// toda la plataforma).
model UsuarioPlataforma {
  id            String               @id @default(cuid())
  email         String               @unique
  passwordHash  String
  mfaSecret     String?
  mfaHabilitado Boolean              @default(false)
  rol           RolUsuarioPlataforma

  // Mismo criterio de bloqueo temporal que Usuario (src/infra/auth/rateLimit.ts),
  // pero implementado aparte (Seccion 18.2.F): este actor no tiene empresaId,
  // asi que no puede pasar por tenantClient().
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?

  createdAt DateTime @default(now())

  cuestionariosPublicados CuestionarioVersion[]

  @@map("usuarios_plataforma")
}

// RF20 — aggregate root de version (patron de Seccion 18.3.A, compartido
// con DefinicionKpi del Incremento 4): codigo (identidad logica estable) +
// numero (incremental) + estado. Publicada es inmutable: el unico modulo
// de escritura (src/domain/versionado/publicarCuestionario.ts) rechaza
// cualquier edicion post-publicacion y crea numero+1 en su lugar; el
// indice unico parcial de la migracion (WHERE estado = 'PUBLICADA') es el
// backstop de base de datos.
// R5-5 (Ronda 5) -- ese indice unico parcial (uq_cuestionario_version_publicada,
// prisma/migrations/20260916150000_incremento2_evaluacion_expres_v2) no es
// representable en schema.prisma (Prisma no soporta indices parciales en su
// DSL): existe solo en la migracion SQL escrita a mano. Una futura
// `prisma migrate dev` con red real NO debe interpretarlo como "drift" ni
// intentar generar una migracion que lo elimine -- mismo patron de riesgo
// que el indice parcial de CicloPulso.estado = 'ABIERTO' (ver comentario en
// ese modelo).
model CuestionarioVersion {
  id          String                 @id @default(cuid())
  codigo      String // "evaluacion-expres-v2"
  numero      Int
  estado      EstadoVersionContenido @default(BORRADOR)
  publicadaEn DateTime?
  retiradaEn  DateTime?
  // R5-17 -- el comentario original de esta columna decia "sin relacion FK
  // a proposito", pero la linea de abajo si define una relacion (curador)
  // con su FK -- quedo desactualizado de una version anterior del schema.
  // Nullable porque un BORRADOR puede no tener curador asignado todavia
  // (Seccion 13); onDelete por defecto (Restrict) es intencional: no tiene
  // sentido borrar un UsuarioPlataforma que curo versiones existentes.
  curadorId String?
  curador   UsuarioPlataforma? @relation(fields: [curadorId], references: [id])
  notasCambio String?

  preguntas          PreguntaVersion[]
  evaluacionesExpres EvaluacionExpresV2[]

  @@unique([codigo, numero])
  // R5-25 -- sin este indice, "que versiones curo este usuario de
  // plataforma" (o el JOIN que arma la relacion "curador") hace un scan
  // completo de la tabla; curadorId es nullable pero eso no le quita valor
  // al indice para las filas que si lo tienen.
  @@index([curadorId])
  @@map("cuestionario_versiones")
}

// RF20 — fila hija inmutable. "codigo" (Q1..Q7) es estable entre
// versiones para permitir series historicas aunque el texto cambie.
// onDelete: Restrict — una version con respuestas reales atadas nunca se
// borra.
model PreguntaVersion {
  id                    String              @id @default(cuid())
  cuestionarioVersionId String
  cuestionarioVersion   CuestionarioVersion @relation(fields: [cuestionarioVersionId], references: [id], onDelete: Restrict)
  codigo                String // "Q1".."Q7", estable entre versiones
  orden                 Int
  texto                 String
  dimension             DimensionDiagnosticoV2
  // Lista fija de opciones (valor, texto, orden) — sin tabla propia:
  // contenido de solo lectura, mismo espiritu que los snapshot JSON de
  // este mismo bloque.
  opciones              Json
  // Subpregunta contextual de Q5 (texto libre, no puntuable en el motor).
  esNoPuntuable         Boolean             @default(false)

  respuestas Respuesta[]

  @@unique([cuestionarioVersionId, codigo])
  @@map("pregunta_versiones")
}

// RF21 — evaluacion anonima V2, tabla nueva y paralela a EvaluacionExpres
// (v1, RF11-RF18), que queda congelada sin cambios (requirements.md
// Seccion 13.0). Tenant nulo explicito, mismo regimen que EvaluacionExpres
// (Seccion 18.2.B): sin empresaId, sin politica RLS, protegida por
// LimiteTasa + cascada + disciplina de nunca exponer una lectura directa
// de sus hijas. Aggregate root de este sub-grafo — Respuesta/Consentimiento/
// Hallazgo siempre se acceden anidados desde este id, nunca top-level.
model EvaluacionExpresV2 {
  id                    String              @id @default(cuid())
  cuestionarioVersionId String
  cuestionarioVersion   CuestionarioVersion @relation(fields: [cuestionarioVersionId], references: [id], onDelete: Restrict)

  // Contexto previo no puntuable (requirements.md Seccion 13, §7.1).
  pais             String    @default("PE")
  region           String?
  sector           String?
  subsector        String?
  rangoTamano      String?
  rolParticipante  String?
  productoServicio String // "una cadena concreta" — principio 2
  periodoInicio    DateTime
  periodoFin       DateTime
  tipoOperacion    String

  // Gate macro/detalle (RF21/RF22) — mismo mecanismo que EvaluacionExpres
  // v1: el resultado completo se calcula UNA sola vez en /complete y se
  // persiste de inmediato; el endpoint de detalle solo revela mas campos
  // del mismo registro, nunca recalcula.
  detalleDesbloqueado   Boolean   @default(false)
  detalleDesbloqueadoEn DateTime?
  correo                String?
  nombreCompleto        String?
  empresaNombre         String?
  telefono              String?

  // RF25/RF26 + retencion (src/infra/retencion.ts, extendido a esta tabla):
  // huella de origen solo para limitar abuso, purgada a las 48-72h.
  huellaOrigen          String
  huellaOrigenPurgadaEn DateTime?

  createdAt DateTime @default(now())

  respuestas      Respuesta[]
  consentimientos ConsentimientoExpres[]
  hallazgos       HallazgoExpres[]

  @@index([huellaOrigen])
  @@index([createdAt])
  @@index([cuestionarioVersionId])
  @@map("evaluaciones_expres_v2")
}

// RF21 — respuesta a UNA pregunta de una version concreta. Entidad hija de
// EvaluacionExpresV2 (Seccion 18.2.B: "Respuesta es entidad hija, no su
// propio aggregate") — se accede siempre por evaluacionExpresV2Id, nunca
// se lista de forma independiente (evitaria el gate de detalle). "noSabe"
// nunca es cero, mismo principio que RespuestaCruda (RF6) del motor v1.
model Respuesta {
  id                   String             @id @default(cuid())
  evaluacionExpresV2Id String
  evaluacionExpresV2   EvaluacionExpresV2 @relation(fields: [evaluacionExpresV2Id], references: [id], onDelete: Cascade)
  preguntaVersionId    String
  preguntaVersion      PreguntaVersion    @relation(fields: [preguntaVersionId], references: [id], onDelete: Restrict)

  opcionSeleccionada String?
  noSabe             Boolean @default(false)
  contextoLibre      String? // subpregunta no puntuable de Q5

  createdAt DateTime @default(now())

  @@unique([evaluacionExpresV2Id, preguntaVersionId])
  // R5-25 -- el unique de arriba tiene a evaluacionExpresV2Id como primera
  // columna, asi que no sirve para resolver "que respuestas usan esta
  // preguntaVersion" (regla del prefijo izquierdo de un indice B-tree
  // compuesto) -- la consulta que dispara el onDelete: Restrict de
  // preguntaVersion (y cualquier reporte por pregunta) necesita su propio
  // indice.
  @@index([preguntaVersionId])
  @@map("respuestas")
}

// RF23/RF24 (Seccion 18.2.A) — consentimiento append-only del flujo
// anonimo. Tenant nulo, mismo regimen que EvaluacionExpresV2: SIN RLS.
// Append-only garantizado a nivel de permisos de Postgres, no solo de
// disciplina de aplicacion — ver REVOKE UPDATE, DELETE en la migracion.
// Retirar consentimiento es una fila NUEVA (aceptado=false, retiradoEn),
// nunca un UPDATE sobre la original. "textoSnapshot" es el texto legal
// COMPLETO mostrado en ese momento (no un puntero a una version futura
// que podria cambiar) — RF23 exige reproducir el texto exacto.
model ConsentimientoExpres {
  id                   String             @id @default(cuid())
  evaluacionExpresV2Id String
  evaluacionExpresV2   EvaluacionExpresV2 @relation(fields: [evaluacionExpresV2Id], references: [id], onDelete: Cascade)

  finalidad     FinalidadConsentimiento
  aceptado      Boolean
  textoVersion  String
  textoSnapshot String // texto legal completo mostrado, nunca solo un puntero
  jurisdiccion  String       @default("PE")
  vigenteDesde  DateTime     @default(now())
  metodoRetiro  MetodoRetiro @default(NINGUNO)
  retiradoEn    DateTime?

  createdAt DateTime @default(now())

  // R5-18 -- la consulta real (RF23/RF24) es "el consentimiento vigente
  // mas reciente de esta evaluacion para esta finalidad", es decir el
  // mismo filtro de mas abajo pero ORDER BY createdAt DESC LIMIT 1.
  // Agregar createdAt al final del indice compuesto deja que Postgres
  // resuelva el ORDER BY con el indice (evita un sort aparte) sin
  // necesitar un segundo indice solo para eso.
  @@index([evaluacionExpresV2Id, finalidad, createdAt], map: "consentimientos_expres_evaluacionExpresV2Id_finalidad_createdAt")
  @@map("consentimientos_expres")
}

// RF23/RF24 — misma finalidad de consentimiento pero para una cuenta
// registrada (Usuario/Empresa). A diferencia de ConsentimientoExpres, esta
// tabla SI tiene empresaId propio y entra en TENANT_SCOPED_MODELS +
// prisma/rls.sql (primera tabla tenant-scoped nueva desde el Incremento 1
// — Seccion 18.3.B la usa como caso de prueba de la regla "RLS en la
// misma migracion"). Ningun flujo de este incremento la muestra/solicita
// todavia (requirements.md Seccion 13.8) — se crea ahora porque es
// transversal, sin UI propia hasta un incremento posterior.
model ConsentimientoCuenta {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  finalidad     FinalidadConsentimiento
  aceptado      Boolean
  textoVersion  String
  textoSnapshot String
  jurisdiccion  String       @default("PE")
  vigenteDesde  DateTime     @default(now())
  metodoRetiro  MetodoRetiro @default(NINGUNO)
  retiradoEn    DateTime?

  createdAt DateTime @default(now())

  // R5-18 -- mismo motivo que ConsentimientoExpres de arriba: createdAt al
  // final del indice para resolver "el mas reciente por finalidad" sin un
  // sort aparte.
  @@index([empresaId, usuarioId, finalidad, createdAt], map: "consentimientos_cuenta_empresaId_usuarioId_finalidad_createdAt_")
  @@map("consentimientos_cuenta")
}

// RF22/RNF10 (Seccion 18.2.C) — hallazgo de la evaluacion expres V2. Solo
// variables NO identificables en "contextoSnapshot" — nunca un id de fila
// de Respuesta aqui. La trazabilidad operacional (para que el propio
// visitante vea su resultado detallado) vive en HallazgoExpresTraza, una
// tabla SEPARADA con permisos propios — la separacion es estructural (dos
// tablas), no solo una lista de columnas a evitar.
//
// R5-3 (Ronda 5, correccion 2026-09-16) — el comentario original de este
// bloque decia que Investigacion (Incremento 6) "nunca tiene acceso a la
// tabla de traza" y dejaba entender que eso bastaba para el anonimato.
// Eso es incompleto: evaluacionExpresV2Id (abajo) es un FK real hacia
// EvaluacionExpresV2, que SI puede tener correo/nombreCompleto/telefono
// (si detalleDesbloqueado=true) — un JOIN corriente desde HallazgoExpres
// hasta ahi re-identifica al visitante sin tocar HallazgoExpresTraza para
// nada. No se saca el FK: hace falta para que el propio visitante vea su
// resultado detallado (mismo flujo que RF22), y quitarlo no reduciria el
// riesgo de re-identificacion de todos modos (el mismo JOIN por id
// funciona igual a nivel de aplicacion, con o sin FK declarado en el
// schema). El gate real es de ACCESO, no de schema: la funcion
// SECURITY DEFINER de agregacion de Incremento 6 (Seccion 18.2.C) tiene
// que exponer SOLO contextoSnapshot + los campos no identificables ya
// documentados aca abajo, sin GRANT de SELECT sobre "evaluaciones_expres_v2"
// para el rol que la ejecuta — igual criterio de permisos-a-nivel-de-Postgres
// que ya aplica a "hallazgos_expres_traza", extendido explicitamente a
// esta relacion. Ver PLAN-DE-TRABAJO.md, item de backlog de Incremento 6.
model HallazgoExpres {
  id                   String             @id @default(cuid())
  // FK real e intencional (ver nota de arriba) — necesaria para que RF22
  // le muestre al propio visitante su resultado detallado. El limite de
  // anonimato para Investigacion (Incremento 6) se aplica con permisos de
  // Postgres sobre la tabla EvaluacionExpresV2, no quitando este campo.
  evaluacionExpresV2Id String
  evaluacionExpresV2   EvaluacionExpresV2 @relation(fields: [evaluacionExpresV2Id], references: [id], onDelete: Cascade)

  dimension             DimensionDiagnosticoV2
  estadoCategoria       String // uno de los 5 estados por dimension (catalogo cerrado en src/engine/v2)
  enunciado             String
  estadoEvidencia       EstadoEvidencia
  coberturaConfianza    Float
  evidenciaFaltante     String[]
  siguienteVerificacion String?
  ruleVersion           String // "v2-preliminary"

  // UNICO campo que el pipeline de Investigacion (Incremento 6) lee para
  // construir un DatasetVersion — solo variables no identificables:
  // { dimension, sector, subsector, rangoTamano, rolParticipante, pais,
  //   preguntaCodigos, ruleVersion }. Nunca un id de Respuesta aqui.
  contextoSnapshot Json

  createdAt DateTime @default(now())

  traza HallazgoExpresTraza?

  @@index([evaluacionExpresV2Id])
  @@map("hallazgos_expres")
}

// RF22/RNF10 — trazabilidad operacional 1:1 de un HallazgoExpres, en tabla
// propia con permisos propios (nunca la misma tabla que HallazgoExpres).
// Investigacion (Incremento 6) NUNCA hace JOIN contra esta tabla — su
// funcion SECURITY DEFINER de agregacion (Seccion 18.2.C) directamente no
// tiene GRANT hacia "hallazgos_expres_traza".
model HallazgoExpresTraza {
  id               String         @id @default(cuid())
  hallazgoExpresId String         @unique
  hallazgoExpres   HallazgoExpres @relation(fields: [hallazgoExpresId], references: [id], onDelete: Cascade)
  respuestaIds     String[]

  createdAt DateTime @default(now())

  @@map("hallazgos_expres_traza")
}

// Incremento 3 -- Mapa y profundidad (requirements.md Seccion 14,
// RF27-RF39; MVP-DEFINITIVO.md Seccion 6.2). Cadena/Nodo/ConexionCadena/
// Flujo son entidades NUEVAS Y ADITIVAS (Seccion 5 de MVP-DEFINITIVO.md)
// -- no reemplazan Empresa/Eslabon/Conexion del flujo de cuenta completa
// v1, que sigue operando sin cambios. Tablas tenant-scoped con empresaId
// propio denormalizado (mismo criterio que Eslabon/Conexion) -- ver
// PATRONES.md Seccion 5: cada una entra en TENANT_SCOPED_MODELS
// (tenantClient.ts) y lleva su propia politica RLS, en la MISMA
// migracion que las crea.

// RF27 -- alcance de un producto/servicio y un periodo concretos
// (principio 2, Seccion 2 de requirements.md). Nunca "la empresa en general".
model Cadena {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre           String
  productoServicio String
  periodoInicio    DateTime
  periodoFin       DateTime
  tipoOperacion    String // manufactura|distribucion|comercio|servicios|otra

  nodos      Nodo[]
  conexiones ConexionCadena[]
  hallazgos  HallazgoCadena[]
  respuestas RespuestaCadena[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@map("cadenas")
}

// RF28 -- nodo del mapa: catalogo mas amplio que Eslabon (TipoNodo). El
// puente opcional a Eslabon (eslabonRefId) NUNCA fuerza fusion de datos
// ni migracion historica (Seccion 14.0 de requirements.md).
model Nodo {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cadenaId  String
  cadena    Cadena  @relation(fields: [cadenaId], references: [id], onDelete: Cascade)

  nombre String
  tipo   TipoNodo

  // RF28/Seccion 14.0 -- puente opcional, sin fusion conceptual con Eslabon.
  eslabonRefId String?
  eslabonRef   Eslabon? @relation(fields: [eslabonRefId], references: [id], onDelete: SetNull)

  // Posicion elegida por el usuario al arrastrar el nodo sobre el canvas
  // del mapa (RF34, extension post-lanzamiento -- PLAN-DE-TRABAJO.md las
  // dejo pendientes a proposito hasta que existiera la edicion interactiva).
  // Nulas para todo nodo que todavia no se arrastro nunca (los ya
  // existentes, y cualquier nodo recien creado): MapaCadenaCanvas.tsx cae
  // a un layout en grilla calculado en el cliente cuando faltan.
  posX Float?
  posY Float?

  conexionesOrigen  ConexionCadena[] @relation("conexion_cadena_origen")
  conexionesDestino ConexionCadena[] @relation("conexion_cadena_destino")
  // RF38 -- respuestas de RespuestaCadena que eligieron este Nodo como el
  // mas critico de la cadena.
  respuestasNodoCritico RespuestaCadena[] @relation("respuesta_cadena_nodo_critico")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([cadenaId])
  @@map("nodos")
}

// RF29-RF33 -- relacion dirigida entre dos Nodo de la MISMA Cadena.
// Entidad nueva y distinta de la Conexion ya construida (RF2/RF3, flujo
// de cuenta completa v1) -- no la extiende ni la reemplaza (Seccion 14.0).
model ConexionCadena {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cadenaId  String
  cadena    Cadena  @relation(fields: [cadenaId], references: [id], onDelete: Cascade)

  origenNodoId  String
  origenNodo    Nodo @relation("conexion_cadena_origen", fields: [origenNodoId], references: [id])
  destinoNodoId String
  destinoNodo   Nodo @relation("conexion_cadena_destino", fields: [destinoNodoId], references: [id])

  // Punto de conexion (Handle de React Flow) usado en cada extremo al
  // crear la conexion en el mapa -- "top"/"right"/"bottom"/"left", ver
  // NodoCadenaVisual en MapaCadenaCanvas.tsx. Nullable: sin esto, React
  // Flow (sourceHandle/targetHandle sin especificar en el Edge) usa
  // siempre "el primer handle declarado" del nodo, que en nuestro caso es
  // "top" -- la linea se dibujaba arriba sin importar por que lado se
  // habia arrastrado, y volvia a "arriba" en cada recarga de la pagina
  // (bug real que reporto Alex, 2026-09-23). Conexiones creadas antes de
  // esta migracion quedan en null y siguen cayendo al comportamiento
  // anterior (arriba) hasta que se editen/recreen.
  origenHandleId  String?
  destinoHandleId String?

  flujos     FlujoConexionCadena[]
  hallazgos  HallazgoCadena[]
  respuestas RespuestaCadena[]

  // RF30 -- requerimiento recibido, cada indicador independiente de si
  // aplica a esta conexion (nunca combinados en un unico indicador).
  requerimientoCantidad       Boolean @default(false)
  requerimientoFecha          Boolean @default(false)
  requerimientoEspecificacion Boolean @default(false)
  requerimientoAprobacion     Boolean @default(false)
  requerimientoPago           Boolean @default(false)

  // RF30 -- coincidencia con lo requerido; null = "no se sabe", nunca un
  // tercer valor booleano forzado.
  coincidePrioridad Boolean?
  coincideCantidad  Boolean?
  coincideFecha     Boolean?

  // RF31 -- misma escala categorica Corto/Medio/Largo ya definida en RF3.
  oportunidadInformacion DuracionCategorica?
  responsableDecision    String?

  // RF32 -- los mismos cinco campos de criticidad que ya exige RF3 para
  // una Conexion (impactoFalla/tieneAlternativa/tiempoTolerable/
  // tiempoRecuperacion), mas "alternativaProbada", que RF32 agrega y RF3
  // no tiene. "impactoFalla" reutiliza NivelImpacto: misma pregunta ("que
  // tan severo es el impacto si esto falla"), solo cambia el nombre del
  // campo por contexto (PATRONES.md Seccion 6).
  impactoFalla       NivelImpacto?
  tieneAlternativa   Boolean?
  alternativaProbada Boolean?
  tiempoTolerable    DuracionCategorica?
  tiempoRecuperacion DuracionCategorica?

  // RF33 -- reutiliza EstadoEvidencia (RF22/Incremento 2), NUNCA
  // EstadoDato (responde una pregunta distinta, ver PATRONES.md Seccion 6).
  estadoEvidencia EstadoEvidencia @default(DECLARADO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([origenNodoId, destinoNodoId])
  @@index([empresaId])
  @@index([cadenaId])
  @@map("conexiones_cadena")
}

// RF29 -- tabla hija SIN empresaId propio (mismo patron que
// RespuestaCruda, PATRONES.md): una ConexionCadena soporta multiples
// flujos simultaneos, cada uno una fila propia en vez de un array repetido.
model FlujoConexionCadena {
  id               String         @id @default(cuid())
  conexionCadenaId String
  conexionCadena   ConexionCadena @relation(fields: [conexionCadenaId], references: [id], onDelete: Cascade)
  tipo             TipoFlujoV2

  createdAt DateTime @default(now())

  @@unique([conexionCadenaId, tipo])
  @@map("flujos_conexion_cadena")
}

// RF38/RF39 -- resultado de una comparacion multi-rol. Una diferencia se
// registra como hallazgo, nunca como culpa ni determinacion automatica de
// quien tiene razon (Seccion 14.5). "contextoSnapshot" sigue el patron de
// snapshot-JSON de PATRONES.md Seccion 1: solo variables no
// identificables, nunca un id de respuesta individual.
model HallazgoCadena {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cadenaId  String
  cadena    Cadena  @relation(fields: [cadenaId], references: [id], onDelete: Cascade)

  // Opcional: una comparacion puede ser de cadena completa (p. ej. "nodo
  // critico") o de una conexion especifica (p. ej. "prioridad elegida").
  conexionCadenaId String?
  conexionCadena   ConexionCadena? @relation(fields: [conexionCadenaId], references: [id], onDelete: SetNull)

  dimension DimensionComparacionCadena
  resultado ResultadoComparacion

  contextoSnapshot Json?

  createdAt DateTime @default(now())

  @@index([empresaId])
  @@index([cadenaId])
  @@map("hallazgos_cadena")
}

// RF36-38 -- respuesta individual de UN invitado (sin cuenta propia, ver
// el comentario de cabecera de invitacionCadena.ts) a las preguntas de
// una Cadena o de una ConexionCadena puntual. "email" es la unica
// identidad que existe: viene del token de invitacion, nunca de un
// Usuario -- decision explicita de Alex (2026-09-24): un link sin login,
// mismo criterio de RF36 ("sin requerir infraestructura adicional") y del
// mismo patron ya usado en la evaluacion expres anonima. Solo se piden
// los campos que aplican al alcance de la invitacion (RF37): "toda la
// cadena" pide prioridadElegida/nodoCriticoId; "una conexion puntual"
// pide las otras cuatro. El campo que no corresponde a ese alcance queda
// null, nunca "sin responder" mezclado con "no aplica" (mismo principio
// que EstadoDato/EstadoEvidencia en otros modelos: null y "no sabe" no
// son lo mismo -- aca no hay opcion "no sabe" en las 4 preguntas
// reutilizadas de ConexionCadena/Nodo porque tampoco la tienen alli).
model RespuestaCadena {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cadenaId  String
  cadena    Cadena  @relation(fields: [cadenaId], references: [id], onDelete: Cascade)

  // null = invitacion a la Cadena completa; presente = invitacion acotada
  // a esta ConexionCadena puntual (RF36, "una cadena o una conexion
  // concreta").
  conexionCadenaId String?
  conexionCadena   ConexionCadena? @relation(fields: [conexionCadenaId], references: [id], onDelete: Cascade)

  email String

  // Alcance "cadena completa":
  prioridadElegida PromesaPrincipalCadena?
  nodoCriticoId    String?
  nodoCritico      Nodo?                   @relation("respuesta_cadena_nodo_critico", fields: [nodoCriticoId], references: [id], onDelete: SetNull)

  // Alcance "conexion puntual":
  conocimientoEntradasSalidas ConocimientoEntradaSalida?
  momentoInformacion          DuracionCategorica? // reutiliza el mismo enum de RF3/RF31
  fuenteDatos                 FuenteDatosCadena?
  tieneAlternativa            Boolean? // mismo par que ConexionCadena.tieneAlternativa/alternativaProbada
  alternativaProbada          Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identidad real "un invitado responde una sola vez por cadena/conexion,
  // reabrir el link actualiza en vez de duplicar" -- NO expresable como
  // @@unique de Prisma porque conexionCadenaId es nullable (Postgres trata
  // cada NULL como distinto en una unique constraint normal, asi que dos
  // invitaciones a la Cadena completa con el mismo email no chocarian).
  // Resuelto con DOS indices unicos PARCIALES a mano en la migracion
  // 20260924000000_respuesta_cadena (mismo patron ya usado por
  // 20260916160000_ciclo_abierto_unico) -- no los borres en un futuro
  // `prisma migrate dev` por "drift", son intencionales.
  @@index([empresaId])
  @@index([cadenaId])
  @@index([conexionCadenaId])
  @@map("respuestas_cadena")
}
