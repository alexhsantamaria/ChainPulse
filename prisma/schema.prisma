// ChainPulse — modelo de datos del Incremento 1.
// Trazabilidad: cada campo no obvio cita el RF/RNF o la ronda de decisiones
// de requirements.md que lo origina. Ver tambien docs/ADR/0001 y 0002.
//
// Aislamiento multi-tenant (RNF1): todo modelo con "empresaId" se protege
// con DOS capas independientes, ninguna opcional:
//   1. La extension de Prisma en src/infra/prisma/tenantClient.ts, que
//      inyecta el filtro de tenant en cada consulta.
//   2. Row-Level Security de PostgreSQL (prisma/migrations/*_rls.sql),
//      que rechaza filas fuera del tenant activo aunque el codigo falle.
// EvaluacionExpres y sus hijas NO llevan empresaId (adenda de ADR-0001):
// es el caso explicito de tenant nulo en las politicas RLS.

generator client {
  provider   = "prisma-client-js"
  // ADR-0003 (adenda ARM64): motor sin binario Rust. La build nativa de
  // Windows ARM64 del query engine no existe (issue cerrado como "not
  // planned" por Prisma) — con engineType="client" el cliente corre en
  // TypeScript puro sobre un driver adapter (src/infra/prisma/client.ts),
  // sin binario nativo que pueda ser incompatible con la arquitectura.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Neon: el rol de la app (y hasta neondb_owner) no tiene privilegio
  // CREATEDB, asi que "prisma migrate dev" no puede crear su base de
  // sombra temporal sola (error P3014). shadowDatabaseUrl apunta a una
  // segunda base ya creada a mano en la consola de Neon (no por SQL,
  // no necesita CREATEDB) -- ver .env.example y el README.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum RolUsuario {
  ADMINISTRADOR
  RESPONSABLE
}

// RF3 / Seccion 12: grado de dependencia, uno de los 4 valores de una Conexion.
enum GradoDependencia {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

// RF3 / Seccion 12: cortes de calibracion inicial para "tiempo tolerable" y
// "tiempo de recuperacion" — Corto = menos de 24h, Medio = 24h-1 semana,
// Largo = mas de 1 semana. Valor de calibracion, ajustable con datos reales.
enum DuracionCategorica {
  CORTO
  MEDIO
  LARGO
}

// Principio de copy de ADR-0002 (punto 4) y campo de esquema pedido por
// CTO en la quinta ronda (Seccion 12): default DECLARADO en el Incremento 1,
// sin UI todavia — evita migrar datos historicos cuando el nivel 3 de
// visualizacion (Seccion 10) necesite distinguir declarado/inferido/verificado.
enum EstadoDato {
  DECLARADO
  INFERIDO
  VERIFICADO
}

// Bloque A del Incremento 2 (PLAN-DE-TRABAJO.md Seccion 18.1.C/18.2.B) — RF15
// distingue el inicio de una evaluacion del desbloqueo de su detalle (RF17),
// ambos protegidos por LimiteTasa con el mismo mecanismo pero contadores
// independientes.
enum BucketLimiteTasa {
  INICIO_EVALUACION
  DESBLOQUEO_DETALLE
}

// RF3, engine v1 (src/engine/criticidad.ts): nivel categorico del impacto
// de una interrupcion sobre la promesa al cliente. RF3 no fijaba una
// escala cerrada para este campo (hallazgo de Full-Stack en la quinta
// ronda) — se adopta esta de 4 niveles, simetrica a GradoDependencia, como
// hipotesis inicial de calibracion (mismo criterio que los demas valores
// numericos de la Seccion 12), ajustable con datos reales de los pilotos.
enum NivelImpacto {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum EstadoCiclo {
  ABIERTO
  CERRADO
}

// RF12: la dimension que el resultado macro senala como "la peor" en la
// frase breve en lenguaje llano.
enum DimensionDiagnostico {
  SALUD
  CRITICIDAD
  DEPENDENCIA
  RIESGO
}

// RF1 — tenant.
model Empresa {
  id        String   @id @default(cuid())
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios   Usuario[]
  eslabones  Eslabon[]
  ciclos     CicloPulso[]
  conexiones Conexion[]

  @@map("empresas")
}

// RF1/RF4. El mecanismo de autenticacion (password, magic link, MFA) queda
// pendiente de un ADR propio (Seguridad, Seccion 12) — este modelo es
// deliberadamente minimo, sin inventar esa decision aqui.
model Usuario {
  id        String     @id @default(cuid())
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  // ADR-0003: email UNICO GLOBAL (no compuesto con empresaId) — el login
  // busca por email sin conocer el tenant de antemano, via la funcion
  // Postgres SECURITY DEFINER login_lookup() (prisma/auth_functions.sql).
  // Unica excepcion deliberada y acotada al aislamiento por RLS.
  email     String     @unique
  nombre    String
  rol       RolUsuario

  // ADR-0003: hash Argon2id, nunca texto plano (src/infra/auth/password.ts).
  passwordHash String

  // ADR-0003: MFA (TOTP) obligatorio para ADMINISTRADOR desde el Incremento 1.
  mfaSecret     String?
  mfaHabilitado Boolean @default(false)

  // ADR-0003: rate limiting / bloqueo temporal contra fuerza bruta en el login.
  intentosFallidos Int       @default(0)
  bloqueadoHasta   DateTime?

  // RF4: un Responsable queda limitado a las conexiones de su propio eslabon.
  eslabonId String?
  eslabon   Eslabon?   @relation(fields: [eslabonId], references: [id])

  respuestas RespuestaCruda[]
  // RNF9 -- instrumentacion minima (ver los dos modelos nuevos al final
  // de este archivo).
  metricasCuestionario       MetricaCuestionario[]
  recomendacionesEjecutadas  RecomendacionEjecutada[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([empresaId])
  @@map("usuarios")
}

// RF2 / Seccion 3 — nodo de la cadena de suministro (sustituye "Area/Proceso").
model Eslabon {
  id                 String     @id @default(cuid())
  empresaId          String
  empresa            Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre             String
  // Seccion 7 / Seccion 8: modelo flexible desde ya para representar un
  // proveedor externo mas adelante sin rediseno (no se construye UI propia
  // de "Proveedor" en el MVP).
  esProveedorExterno Boolean    @default(false)
  // CTO, Seccion 12: campo de nivel 3 de visualizacion, sin UI en Incremento 1.
  tipoFlujo          String?
  estado             EstadoDato @default(DECLARADO)

  conexionesOrigen  Conexion[] @relation("conexion_origen")
  conexionesDestino Conexion[] @relation("conexion_destino")
  responsables      Usuario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@map("eslabones")
}

// RF3 — dependencia declarada entre dos eslabones, con sus 4 valores base.
// "completa" (RF3/Seccion 6) es false hasta que los 5 datos de este
// requisito quedan confirmados; una conexion incompleta se excluye de RF7
// y RF16.
model Conexion {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  origenId  String
  origen    Eslabon @relation("conexion_origen", fields: [origenId], references: [id])
  destinoId String
  destino   Eslabon @relation("conexion_destino", fields: [destinoId], references: [id])

  gradoDependencia GradoDependencia?
  impactoPromesaCliente NivelImpacto?
  tieneAlternativa      Boolean?
  tiempoTolerable       DuracionCategorica?
  tiempoRecuperacion    DuracionCategorica?
  // Metadatos de procedencia (CTO, Seccion 12): cuando se confirmaron los
  // datos de criticidad, para poder auditar sin fragmentar ruleVersion.
  criticidadConfirmadaEn DateTime?

  tipoFlujo String?
  estado    EstadoDato @default(DECLARADO)
  completa  Boolean    @default(false)

  respuestas RespuestaCruda[]
  resultados ResultadoConexion[]
  // RNF9 -- si esta conexion (como eslabon mas debil de algun ciclo,
  // RF7/RF8) tuvo su recomendacion marcada como ejecutada.
  recomendacionesEjecutadas RecomendacionEjecutada[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([origenId, destinoId])
  @@index([empresaId])
  @@map("conexiones")
}

// RF5 — periodo durante el cual se envia y recoge el cuestionario.
model CicloPulso {
  id        String      @id @default(cuid())
  empresaId String
  empresa   Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  estado    EstadoCiclo @default(ABIERTO)
  abiertoEn DateTime    @default(now())
  cerradoEn DateTime?
  // RF10: % de responsables que completaron, fijado al cerrar el ciclo.
  coberturaRespuesta Float?

  respuestas         RespuestaCruda[]
  resultadosConexion ResultadoConexion[]
  resultadoCiclo     ResultadoCiclo?
  // RNF9 -- instrumentacion minima.
  metricasCuestionario       MetricaCuestionario[]
  recomendacionesEjecutadas  RecomendacionEjecutada[]

  @@index([empresaId])
  @@map("ciclos_pulso")
}

// RF6 / Seccion 12 — respuesta individual, nunca solo el agregado (RNF6).
// Escala Likert 1-5; "noSabe"/"noAplica" nunca cuentan como el minimo de
// la escala (ver src/engine/salud.ts).
model RespuestaCruda {
  id            String     @id @default(cuid())
  cicloPulsoId  String
  cicloPulso    CicloPulso @relation(fields: [cicloPulsoId], references: [id], onDelete: Cascade)
  conexionId    String
  conexion      Conexion   @relation(fields: [conexionId], references: [id], onDelete: Cascade)
  responsableId String
  // Hallazgo real de RNF1 (ver README): sin onDelete: Cascade aca, borrar
  // un Usuario con respuestas propias fallaba (RESTRICT/NO ACTION, el
  // default de Postgres) aunque la respuesta tambien fuera a borrarse por
  // el otro camino (cicloPulso -> respuesta, que si cascadea). Corregido
  // en la misma migracion que agrega las tablas de RNF9 mas abajo.
  responsable   Usuario    @relation(fields: [responsableId], references: [id], onDelete: Cascade)

  valor    Int? // 1-5; null si noSabe o noAplica
  noSabe   Boolean @default(false)
  noAplica Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([cicloPulsoId, conexionId, responsableId])
  @@index([cicloPulsoId])
  @@map("respuestas_crudas")
}

// RF7 — resultado inmutable por conexion y ciclo (RNF6: nunca se recalcula
// por referencia viva a Conexion; si RF3 se edita despues del cierre, el
// resultado ya persistido no cambia). Un unico "ruleVersion" por resultado
// (CTO, Seccion 12) — no fragmentado por dimension.
model ResultadoConexion {
  id           String     @id @default(cuid())
  cicloPulsoId String
  cicloPulso   CicloPulso @relation(fields: [cicloPulsoId], references: [id], onDelete: Cascade)
  conexionId   String
  conexion     Conexion   @relation(fields: [conexionId], references: [id], onDelete: Cascade)

  salud   Float // 0-100 (RF6)
  // Snapshot de los datos de criticidad al momento del cierre del ciclo,
  // no una referencia viva a Conexion (CTO, Seccion 12).
  criticidadSnapshot      Json
  gradoDependenciaSnapshot GradoDependencia
  riesgo                  Float

  ruleVersion String
  createdAt   DateTime @default(now())

  @@unique([cicloPulsoId, conexionId])
  @@index([cicloPulsoId])
  @@map("resultados_conexion")
}

// RF7 (conjunto no dominado) + RF16 (indice de integracion) — el agregado
// de un ciclo completo, tambien inmutable.
model ResultadoCiclo {
  id           String     @id @default(cuid())
  cicloPulsoId String     @unique
  cicloPulso   CicloPulso @relation(fields: [cicloPulsoId], references: [id], onDelete: Cascade)

  indiceIntegracion    Float // RF16
  // conexionId[] del conjunto no dominado, YA ordenados por el criterio de
  // lectura de RF7 (criticidad desc, salud asc, riesgo desc, dependencia
  // desc, id) — ver src/engine/eslabonMasDebil.ts.
  eslabonesMasDebilesIds String[]

  ruleVersion String
  createdAt   DateTime @default(now())

  @@map("resultados_ciclo")
}

// RNF9 — instrumentacion minima: cuanto tarda un responsable en
// completar el cuestionario de un ciclo (RF6), frente al limite de 5
// minutos de RNF2. Una fila por envio, no por respuesta individual (una
// persona responde varias conexiones de una vez). La duracion se mide en
// el cliente (desde que carga el formulario hasta que se envia,
// src/app/dashboard/ciclos/[id]/responder/ResponderCuestionarioForm.tsx)
// y llega ya calculada junto con las respuestas -- no hace falta un
// evento de "inicio" separado en el servidor. No es un sistema de
// analitica de producto completo (Seccion 12 de requirements.md): esto
// es la senal minima para una consulta agregada simple, no un evento por
// interaccion.
model MetricaCuestionario {
  id               String     @id @default(cuid())
  cicloPulsoId     String
  cicloPulso       CicloPulso @relation(fields: [cicloPulsoId], references: [id], onDelete: Cascade)
  responsableId    String
  responsable      Usuario    @relation(fields: [responsableId], references: [id], onDelete: Cascade)
  duracionSegundos Int

  createdAt DateTime @default(now())

  @@index([cicloPulsoId])
  @@map("metricas_cuestionario")
}

// RNF9 — si el administrador o el responsable de una conexion marca la
// recomendacion priorizada (RF8) como ejecutada. La recomendacion en si
// no se persiste (ver src/engine/recomendacion.ts) -- esto se ancla al
// par (ciclo, conexion) que la genero, no al texto/prioridad puntual
// (que puede recalcularse distinto si las reglas cambian mas adelante).
// @@unique evita marcar la misma dos veces.
model RecomendacionEjecutada {
  id           String     @id @default(cuid())
  cicloPulsoId String
  cicloPulso   CicloPulso @relation(fields: [cicloPulsoId], references: [id], onDelete: Cascade)
  conexionId   String
  conexion     Conexion   @relation(fields: [conexionId], references: [id], onDelete: Cascade)
  marcadaPorId String
  marcadaPor   Usuario    @relation(fields: [marcadaPorId], references: [id], onDelete: Cascade)

  marcadaEn DateTime @default(now())

  @@unique([cicloPulsoId, conexionId])
  @@map("recomendaciones_ejecutadas")
}

// RF11-RF18 — evaluacion exprés publica. Sin tenantId a proposito (RNF7):
// fuente de datos separada de las cuentas registradas, nunca mezclada al
// recalcular o mejorar el motor sin un criterio explicito de ponderacion.
model EvaluacionExpres {
  id          String @id @default(cuid())
  ruleVersion String

  // Resultado macro (RF12): se calcula UNA sola vez aqui y se persiste de
  // inmediato — el gate de RF13 solo revela campos de este mismo registro,
  // nunca recalcula (CTO, Seccion 12: gate de presentacion, no de computo).
  saludPromedio       Float
  criticidadPromedio  Float
  dependenciaPromedio Float
  riesgoPromedio      Float
  indiceIntegracion   Float // RF16
  dimensionMasDebil   DimensionDiagnostico

  // Gate de detalle (RF13/RF17).
  detalleDesbloqueado   Boolean   @default(false)
  detalleDesbloqueadoEn DateTime?
  correo                String?
  nombreCompleto        String?
  empresaNombre         String?
  telefono              String? // RF13: opcional, no bloquea el desbloqueo
  consentimientoEnvio           Boolean @default(false)
  consentimientoMejoraAlgoritmo Boolean @default(false)

  // RF15/RF17 + retencion de la Seccion 12: huella de origen SOLO para
  // limitar abuso, purgada a las 48-72h (antes que cualquier otro dato de
  // esta fila) via el job descrito en src/infra/retencion.ts.
  huellaOrigen          String
  huellaOrigenPurgadaEn DateTime?

  createdAt DateTime @default(now())

  eslabones  EvaluacionExpresEslabon[]
  conexiones EvaluacionExpresConexion[]

  @@index([huellaOrigen])
  @@index([createdAt])
  @@map("evaluaciones_expres")
}

// RF11 — version condensada de Eslabon, propia de la evaluacion exprés.
model EvaluacionExpresEslabon {
  id                 String           @id @default(cuid())
  evaluacionExpresId String
  evaluacionExpres   EvaluacionExpres @relation(fields: [evaluacionExpresId], references: [id], onDelete: Cascade)
  nombre             String
  tipoFlujo          String?
  estado             EstadoDato       @default(DECLARADO)

  @@index([evaluacionExpresId])
  @@map("evaluaciones_expres_eslabones")
}

// RF11/RF18 — version condensada de Conexion. "descripcionLibre" es el
// campo de texto libre que RF18 protege con un alias sugerido por defecto
// en la UI (no se valida/bloquea aqui, es una guia de minimizacion).
model EvaluacionExpresConexion {
  id                 String           @id @default(cuid())
  evaluacionExpresId String
  evaluacionExpres   EvaluacionExpres @relation(fields: [evaluacionExpresId], references: [id], onDelete: Cascade)

  origenNombre  String
  destinoNombre String

  gradoDependencia       GradoDependencia
  impactoPromesaCliente  NivelImpacto?
  tieneAlternativa       Boolean?
  tiempoTolerable        DuracionCategorica?
  tiempoRecuperacion     DuracionCategorica?
  descripcionLibre       String?

  // Salud declarada por el visitante para esta conexion (percepcion de una
  // sola persona — RNF7, confiabilidad distinta a un ciclo real).
  salud Float?

  @@index([evaluacionExpresId])
  @@map("evaluaciones_expres_conexiones")
}

// Bloque A del Incremento 2 (PLAN-DE-TRABAJO.md Seccion 18.1.C, 18.4.F) —
// rate limiting Postgres-nativo de RF15/RF17, sin Redis/store externo (por
// eso RATE_LIMIT_STORE_URL sale de .env.example, ver Seccion 18.1.C). Tenant
// nulo explicito, mismo caso que EvaluacionExpres arriba: nunca lleva
// empresaId ni entra en las politicas de prisma/rls.sql. huellaOrigenHash es
// siempre un hash salteado (nunca la IP en claro, src/infra/rateLimit) y
// ventanaInicio es el inicio de la hora en curso (ventana fija, no
// deslizante) — la fila se resuelve con un UPSERT atomico
// (src/infra/rateLimit/limiteTasa.ts) para que invocaciones serverless
// concurrentes nunca pierdan un incremento.
model LimiteTasa {
  id                String            @id @default(cuid())
  huellaOrigenHash  String
  bucket            BucketLimiteTasa
  ventanaInicio     DateTime
  contador          Int               @default(0)
  createdAt         DateTime          @default(now())

  @@unique([huellaOrigenHash, bucket, ventanaInicio])
  @@index([ventanaInicio])
  @@map("limite_tasa")
}
